---
// Pure Astro component — zero framework JS
---

<div class="space-y-5">

  <!-- Form card -->
  <div class="bg-white rounded-2xl ring-1 ring-gray-900/[0.08] shadow-xl shadow-green-900/[0.08] overflow-hidden">
    <div class="px-6 py-4 bg-gray-950 flex items-center gap-2">
      <svg class="w-4 h-4 text-violet" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.75.75 0 0 1 1.362-.632A6.5 6.5 0 1 1 8 1.5v-.75a.75.75 0 0 1 1.28-.53l2 2a.75.75 0 0 1 0 1.06l-2 2A.75.75 0 0 1 8 5.03V3z" clip-rule="evenodd"/>
      </svg>
      <span class="text-sm font-bold text-white">Diet Break Calculator</span>
      <span class="text-sm" style="color: rgba(255,255,255,0.65);">· Enter Your Details</span>
    </div>

    <div class="p-6 sm:p-8 space-y-6">

      <!-- Sex -->
      <div>
        <p class="text-xs font-semibold text-gray-600 uppercase tracking-wider mb-2.5">Sex</p>
        <div class="grid grid-cols-2 gap-2.5" id="db-sex-group">
          <button type="button" data-sex="male"
            class="flex flex-col items-start gap-0.5 px-4 py-3 rounded-xl border text-left transition-all cursor-pointer w-full border-violet bg-violet-subtle ring-1 ring-violet/20">
            <span class="text-sm font-bold text-violet-dark">Male</span>
          </button>
          <button type="button" data-sex="female"
            class="flex flex-col items-start gap-0.5 px-4 py-3 rounded-xl border text-left transition-all cursor-pointer w-full border-gray-200 bg-white hover:border-gray-300">
            <span class="text-sm font-bold text-gray-700">Female</span>
          </button>
        </div>
      </div>

      <!-- Age -->
      <div>
        <label for="db-age" class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-2.5">Age</label>
        <div class="relative w-32">
          <input id="db-age" type="number" inputmode="numeric" min="18" max="100" placeholder="30"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 hover:border-gray-300 text-sm font-medium bg-white focus:outline-none focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors placeholder:text-gray-300 pr-10"/>
          <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-gray-500 pointer-events-none select-none">yrs</span>
        </div>
        <p id="db-age-err" class="mt-1.5 text-xs text-red-500 font-medium hidden">Enter age (18–100).</p>
      </div>

      <!-- Weight -->
      <div>
        <div class="flex items-center justify-between mb-2.5">
          <label id="db-weight-label" class="block text-xs font-semibold text-gray-600 uppercase tracking-wider">Weight (lbs)</label>
          <div id="db-weight-toggle" class="inline-flex rounded-xl bg-gray-100 p-1 gap-0.5">
            <button type="button" data-wunit="imperial"
              class="rounded-lg font-semibold transition-all px-3 py-1.5 text-xs bg-white text-gray-900 shadow-sm border border-gray-200">lbs</button>
            <button type="button" data-wunit="metric"
              class="rounded-lg font-semibold transition-all px-3 py-1.5 text-xs text-gray-500 hover:text-gray-700">kg</button>
          </div>
        </div>
        <div class="relative">
          <input id="db-weight" type="number" inputmode="decimal" min="50" max="700" placeholder="185"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 hover:border-gray-300 text-sm font-medium bg-white focus:outline-none focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors placeholder:text-gray-300 pr-10"/>
          <span id="db-weight-unit-label" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-gray-500 pointer-events-none select-none">lbs</span>
        </div>
        <p id="db-weight-err" class="mt-1.5 text-xs text-red-500 font-medium hidden">Enter a valid weight.</p>
      </div>

      <!-- Height -->
      <div>
        <div class="flex items-center justify-between mb-2.5">
          <label id="db-height-label" class="block text-xs font-semibold text-gray-600 uppercase tracking-wider">Height (ft / in)</label>
          <div id="db-height-toggle" class="inline-flex rounded-xl bg-gray-100 p-1 gap-0.5">
            <button type="button" data-hunit="imperial"
              class="rounded-lg font-semibold transition-all px-3 py-1.5 text-xs bg-white text-gray-900 shadow-sm border border-gray-200">ft / in</button>
            <button type="button" data-hunit="metric"
              class="rounded-lg font-semibold transition-all px-3 py-1.5 text-xs text-gray-500 hover:text-gray-700">cm</button>
          </div>
        </div>
        <div id="db-ht-imp">
          <div class="flex gap-2">
            <div class="relative w-24">
              <input id="db-ft" type="number" inputmode="numeric" min="1" max="8" placeholder="5"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 hover:border-gray-300 text-sm font-medium bg-white focus:outline-none focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors placeholder:text-gray-300 pr-8"/>
              <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-gray-500 pointer-events-none select-none">ft</span>
            </div>
            <div class="relative w-24">
              <input id="db-in" type="number" inputmode="numeric" min="0" max="11" placeholder="10"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 hover:border-gray-300 text-sm font-medium bg-white focus:outline-none focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors placeholder:text-gray-300 pr-7"/>
              <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-gray-500 pointer-events-none select-none">in</span>
            </div>
          </div>
          <p id="db-ft-err" class="mt-1.5 text-xs text-red-500 font-medium hidden">Enter feet (1–8).</p>
          <p id="db-in-err" class="mt-1.5 text-xs text-red-500 font-medium hidden">Enter inches (0–11).</p>
        </div>
        <div id="db-ht-met" class="hidden">
          <div class="relative">
            <input id="db-cm" type="number" inputmode="numeric" min="100" max="250" placeholder="178"
              class="w-full px-4 py-3 rounded-xl border border-gray-200 hover:border-gray-300 text-sm font-medium bg-white focus:outline-none focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors placeholder:text-gray-300 pr-12"/>
            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-gray-500 pointer-events-none select-none">cm</span>
          </div>
          <p id="db-cm-err" class="mt-1.5 text-xs text-red-500 font-medium hidden">Enter height in cm (100–250).</p>
        </div>
      </div>

      <!-- Activity Level -->
      <div>
        <label for="db-activity" class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-2.5">Activity Level</label>
        <div class="relative">
          <select id="db-activity"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 hover:border-gray-300 text-sm font-medium bg-white focus:outline-none focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors appearance-none pr-10">
            <option value="1.2">Sedentary (little or no exercise)</option>
            <option value="1.375">Lightly Active (1–3 days/week)</option>
            <option value="1.55" selected>Moderately Active (3–5 days/week)</option>
            <option value="1.725">Very Active (6–7 days/week)</option>
            <option value="1.9">Extremely Active (hard exercise + physical job)</option>
          </select>
          <svg class="absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd"/>
          </svg>
        </div>
      </div>

      <!-- Body Fat % (optional) -->
      <div>
        <label for="db-bf" class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1">
          Body Fat %
          <span class="text-gray-400 font-normal normal-case tracking-normal ml-1">(optional — enables Katch-McArdle)</span>
        </label>
        <p class="text-xs text-gray-400 mb-2.5">Leave blank to use Mifflin-St Jeor</p>
        <div class="relative w-36">
          <input id="db-bf" type="number" inputmode="decimal" min="2" max="60" placeholder="e.g., 20"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 hover:border-gray-300 text-sm font-medium bg-white focus:outline-none focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors placeholder:text-gray-300 pr-7"/>
          <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-gray-500 pointer-events-none select-none">%</span>
        </div>
        <p id="db-bf-err" class="mt-1.5 text-xs text-red-500 font-medium hidden">Enter body fat % (2–60) or leave blank.</p>
      </div>

      <!-- Current Daily Calories -->
      <div>
        <label for="db-cals" class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1">Current Daily Calories</label>
        <p class="text-xs text-gray-400 mb-2.5">What you're eating right now during your cut</p>
        <div class="relative">
          <input id="db-cals" type="number" inputmode="numeric" min="500" max="10000" placeholder="e.g., 1800"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 hover:border-gray-300 text-sm font-medium bg-white focus:outline-none focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors placeholder:text-gray-300 pr-20"/>
          <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-gray-500 pointer-events-none select-none">cal/day</span>
        </div>
        <p id="db-cals-err" class="mt-1.5 text-xs text-red-500 font-medium hidden">Enter your current daily calories (500–10,000).</p>
      </div>

      <!-- Weeks in Deficit -->
      <div>
        <label for="db-weeks" class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1">Weeks in Deficit</label>
        <p class="text-xs text-gray-400 mb-2.5">How long you've been continuously dieting</p>
        <div class="relative w-36">
          <input id="db-weeks" type="number" inputmode="numeric" min="1" max="200" placeholder="e.g., 10"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 hover:border-gray-300 text-sm font-medium bg-white focus:outline-none focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors placeholder:text-gray-300 pr-14"/>
          <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-gray-500 pointer-events-none select-none">weeks</span>
        </div>
        <p id="db-weeks-err" class="mt-1.5 text-xs text-red-500 font-medium hidden">Enter weeks in deficit (1–200).</p>
      </div>

      <!-- Break Type -->
      <div>
        <p class="text-xs font-semibold text-gray-600 uppercase tracking-wider mb-2.5">Break Type</p>
        <div id="db-break-group" class="space-y-2">
          <button type="button" data-break="matador"
            class="flex items-start gap-3 px-4 py-3 rounded-xl border text-left transition-all cursor-pointer w-full border-violet bg-violet-subtle ring-1 ring-violet/20">
            <div>
              <span class="text-sm font-bold text-violet-dark block">Strict MATADOR (2 weeks off / 2 weeks on)</span>
              <span class="text-xs text-violet mt-0.5 block">Research-backed protocol — Byrne et al. 2018</span>
            </div>
          </button>
          <button type="button" data-break="standard"
            class="flex items-start gap-3 px-4 py-3 rounded-xl border text-left transition-all cursor-pointer w-full border-gray-200 bg-white hover:border-gray-300">
            <div>
              <span class="text-sm font-bold text-gray-700 block">Standard Break (1 week off / 4 weeks on)</span>
              <span class="text-xs text-gray-500 mt-0.5 block">Common practitioner convention</span>
            </div>
          </button>
          <button type="button" data-break="maintenance"
            class="flex items-start gap-3 px-4 py-3 rounded-xl border text-left transition-all cursor-pointer w-full border-gray-200 bg-white hover:border-gray-300">
            <div>
              <span class="text-sm font-bold text-gray-700 block">Maintenance Phase (indefinite)</span>
              <span class="text-xs text-gray-500 mt-0.5 block">For goal weight consolidation or extended recovery</span>
            </div>
          </button>
        </div>
      </div>

      <!-- Submit -->
      <div class="pt-2 border-t border-gray-100">
        <button
          id="db-submit"
          type="button"
          class="btn-calc w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 text-white text-sm font-bold rounded-xl shadow-md"
        >
          Plan My Diet Break
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.22 2.97a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.44 8 8.22 4.78a.75.75 0 0 1 0-1.06z" clip-rule="evenodd"/>
            <path fill-rule="evenodd" d="M2.75 8a.75.75 0 0 1 .75-.75h8a.75.75 0 0 1 0 1.5h-8A.75.75 0 0 1 2.75 8z" clip-rule="evenodd"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Results (injected by script) -->
  <div id="db-results" class="hidden"></div>

</div>

<!-- Ensure animate-fade-up is included in Tailwind output -->
<span class="animate-fade-up hidden" aria-hidden="true"></span>

<script>
  const PILL_SM_ACTIVE   = 'rounded-lg font-semibold transition-all px-3 py-1.5 text-xs bg-white text-gray-900 shadow-sm border border-gray-200';
  const PILL_SM_INACTIVE = 'rounded-lg font-semibold transition-all px-3 py-1.5 text-xs text-gray-500 hover:text-gray-700';
  const CARD_ACTIVE   = 'flex flex-col items-start gap-0.5 px-4 py-3 rounded-xl border text-left transition-all cursor-pointer w-full border-violet bg-violet-subtle ring-1 ring-violet/20';
  const CARD_INACTIVE = 'flex flex-col items-start gap-0.5 px-4 py-3 rounded-xl border text-left transition-all cursor-pointer w-full border-gray-200 bg-white hover:border-gray-300';
  const BREAK_ACTIVE   = 'flex items-start gap-3 px-4 py-3 rounded-xl border text-left transition-all cursor-pointer w-full border-violet bg-violet-subtle ring-1 ring-violet/20';
  const BREAK_INACTIVE = 'flex items-start gap-3 px-4 py-3 rounded-xl border text-left transition-all cursor-pointer w-full border-gray-200 bg-white hover:border-gray-300';
  const INPUT_OK    = 'w-full px-4 py-3 rounded-xl border border-gray-200 hover:border-gray-300 text-sm font-medium bg-white focus:outline-none focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors placeholder:text-gray-300';
  const INPUT_ERROR = 'w-full px-4 py-3 rounded-xl border border-red-300 bg-red-50/40 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors placeholder:text-gray-300';
  const ARROW_SVG = `<svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.22 2.97a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.44 8 8.22 4.78a.75.75 0 0 1 0-1.06z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M2.75 8a.75.75 0 0 1 .75-.75h8a.75.75 0 0 1 0 1.5h-8A.75.75 0 0 1 2.75 8z" clip-rule="evenodd"/></svg>`;

  let sex = 'male';
  let weightUnit = 'imperial';
  let heightUnit = 'imperial';
  let breakType = 'matador';

  function setErr(inputId, errId, show, extraClass = '') {
    const inp = document.getElementById(inputId);
    const err = document.getElementById(errId);
    if (inp) inp.className = (show ? INPUT_ERROR : INPUT_OK) + (extraClass ? ' ' + extraClass : '');
    if (err) err.classList.toggle('hidden', !show);
  }

  // ── Sex selector ─────────────────────────────────────────────────────────
  document.querySelectorAll('#db-sex-group button').forEach(btn => {
    btn.addEventListener('click', () => {
      sex = (btn as HTMLButtonElement).dataset.sex!;
      document.querySelectorAll('#db-sex-group button').forEach(b => {
        const active = (b as HTMLButtonElement).dataset.sex === sex;
        b.className = active ? CARD_ACTIVE : CARD_INACTIVE;
        const span = b.querySelector('span');
        if (span) span.className = `text-sm font-bold ${active ? 'text-violet-dark' : 'text-gray-700'}`;
      });
    });
  });

  // ── Weight unit toggle ────────────────────────────────────────────────────
  document.querySelectorAll('#db-weight-toggle [data-wunit]').forEach(btn => {
    btn.addEventListener('click', () => {
      const newUnit = (btn as HTMLButtonElement).dataset.wunit!;
      if (newUnit === weightUnit) return;
      const weightEl = document.getElementById('db-weight') as HTMLInputElement;
      const val = parseFloat(weightEl.value);
      if (!isNaN(val)) {
        if (newUnit === 'metric') {
          weightEl.value = Math.round(val / 2.20462).toString();
          weightEl.placeholder = '84';
          weightEl.min = '22'; weightEl.max = '320';
        } else {
          weightEl.value = Math.round(val * 2.20462).toString();
          weightEl.placeholder = '185';
          weightEl.min = '50'; weightEl.max = '700';
        }
      } else {
        weightEl.placeholder = newUnit === 'metric' ? '84' : '185';
        weightEl.min = newUnit === 'metric' ? '22' : '50';
        weightEl.max = newUnit === 'metric' ? '320' : '700';
      }
      weightUnit = newUnit;
      const lbl = document.getElementById('db-weight-label');
      if (lbl) lbl.textContent = newUnit === 'imperial' ? 'Weight (lbs)' : 'Weight (kg)';
      const unitLbl = document.getElementById('db-weight-unit-label');
      if (unitLbl) unitLbl.textContent = newUnit === 'imperial' ? 'lbs' : 'kg';
      document.querySelectorAll('#db-weight-toggle [data-wunit]').forEach(b => {
        b.className = (b as HTMLButtonElement).dataset.wunit === weightUnit ? PILL_SM_ACTIVE : PILL_SM_INACTIVE;
      });
    });
  });

  // ── Height unit toggle ────────────────────────────────────────────────────
  document.querySelectorAll('#db-height-toggle [data-hunit]').forEach(btn => {
    btn.addEventListener('click', () => {
      const newUnit = (btn as HTMLButtonElement).dataset.hunit!;
      if (newUnit === heightUnit) return;
      if (newUnit === 'metric') {
        const ft = parseFloat((document.getElementById('db-ft') as HTMLInputElement).value) || 0;
        const ins = parseFloat((document.getElementById('db-in') as HTMLInputElement).value) || 0;
        const cm = (ft * 12 + ins) * 2.54;
        if (cm > 0) (document.getElementById('db-cm') as HTMLInputElement).value = Math.round(cm).toString();
      } else {
        const cm = parseFloat((document.getElementById('db-cm') as HTMLInputElement).value) || 0;
        if (cm > 0) {
          const totalIn = cm / 2.54;
          (document.getElementById('db-ft') as HTMLInputElement).value = Math.floor(totalIn / 12).toString();
          (document.getElementById('db-in') as HTMLInputElement).value = Math.round(totalIn % 12).toString();
        }
      }
      heightUnit = newUnit;
      document.getElementById('db-ht-imp')!.classList.toggle('hidden', newUnit !== 'imperial');
      document.getElementById('db-ht-met')!.classList.toggle('hidden', newUnit !== 'metric');
      const lbl = document.getElementById('db-height-label');
      if (lbl) lbl.textContent = newUnit === 'imperial' ? 'Height (ft / in)' : 'Height (cm)';
      document.querySelectorAll('#db-height-toggle [data-hunit]').forEach(b => {
        b.className = (b as HTMLButtonElement).dataset.hunit === heightUnit ? PILL_SM_ACTIVE : PILL_SM_INACTIVE;
      });
    });
  });

  // ── Break type selector ───────────────────────────────────────────────────
  document.querySelectorAll('#db-break-group button').forEach(btn => {
    btn.addEventListener('click', () => {
      breakType = (btn as HTMLButtonElement).dataset.break!;
      document.querySelectorAll('#db-break-group button').forEach(b => {
        const active = (b as HTMLButtonElement).dataset.break === breakType;
        b.className = active ? BREAK_ACTIVE : BREAK_INACTIVE;
        const titleSpan = b.querySelector('span:first-child');
        const noteSpan = b.querySelector('span:last-child');
        if (titleSpan) titleSpan.className = `text-sm font-bold ${active ? 'text-violet-dark' : 'text-gray-700'} block`;
        if (noteSpan) noteSpan.className = `text-xs ${active ? 'text-violet' : 'text-gray-500'} mt-0.5 block`;
      });
    });
  });

  // ── Calculate ─────────────────────────────────────────────────────────────
  document.getElementById('db-submit')!.addEventListener('click', () => {
    // Reset all errors
    setErr('db-age', 'db-age-err', false, 'pr-10');
    setErr('db-weight', 'db-weight-err', false, 'pr-10');
    setErr('db-ft', 'db-ft-err', false, 'pr-8');
    setErr('db-in', 'db-in-err', false, 'pr-7');
    setErr('db-cm', 'db-cm-err', false, 'pr-12');
    setErr('db-cals', 'db-cals-err', false, 'pr-20');
    setErr('db-weeks', 'db-weeks-err', false, 'pr-14');
    const bfEl = document.getElementById('db-bf') as HTMLInputElement;
    const bfErr = document.getElementById('db-bf-err')!;

    let valid = true;

    // Age
    const ageEl = document.getElementById('db-age') as HTMLInputElement;
    const age = parseFloat(ageEl.value);
    if (!ageEl.value || isNaN(age) || age < 18 || age > 100) {
      setErr('db-age', 'db-age-err', true, 'pr-10');
      valid = false;
    }

    // Weight
    const weightEl = document.getElementById('db-weight') as HTMLInputElement;
    const weightVal = parseFloat(weightEl.value);
    const wMin = weightUnit === 'imperial' ? 50 : 22;
    const wMax = weightUnit === 'imperial' ? 700 : 320;
    if (!weightEl.value || isNaN(weightVal) || weightVal < wMin || weightVal > wMax) {
      setErr('db-weight', 'db-weight-err', true, 'pr-10');
      valid = false;
    }

    // Height
    if (heightUnit === 'imperial') {
      const ft = parseFloat((document.getElementById('db-ft') as HTMLInputElement).value);
      const ins = parseFloat((document.getElementById('db-in') as HTMLInputElement).value) || 0;
      if (!(document.getElementById('db-ft') as HTMLInputElement).value || isNaN(ft) || ft < 1 || ft > 8) {
        setErr('db-ft', 'db-ft-err', true, 'pr-8');
        valid = false;
      }
      if (ins < 0 || ins > 11) {
        setErr('db-in', 'db-in-err', true, 'pr-7');
        valid = false;
      }
    } else {
      const cm = parseFloat((document.getElementById('db-cm') as HTMLInputElement).value);
      if (!(document.getElementById('db-cm') as HTMLInputElement).value || isNaN(cm) || cm < 100 || cm > 250) {
        setErr('db-cm', 'db-cm-err', true, 'pr-12');
        valid = false;
      }
    }

    // Current calories
    const calsEl = document.getElementById('db-cals') as HTMLInputElement;
    const currentCals = parseFloat(calsEl.value);
    if (!calsEl.value || isNaN(currentCals) || currentCals < 500 || currentCals > 10000) {
      setErr('db-cals', 'db-cals-err', true, 'pr-20');
      valid = false;
    }

    // Weeks in deficit
    const weeksEl = document.getElementById('db-weeks') as HTMLInputElement;
    const weeks = parseFloat(weeksEl.value);
    if (!weeksEl.value || isNaN(weeks) || weeks < 1 || weeks > 200) {
      setErr('db-weeks', 'db-weeks-err', true, 'pr-14');
      valid = false;
    }

    // Body fat % (optional)
    let bfPct: number | null = null;
    if (bfEl.value) {
      const bfVal = parseFloat(bfEl.value);
      if (isNaN(bfVal) || bfVal < 2 || bfVal > 60) {
        bfEl.className = INPUT_ERROR + ' pr-7';
        bfErr.classList.remove('hidden');
        valid = false;
      } else {
        bfEl.className = INPUT_OK + ' pr-7';
        bfErr.classList.add('hidden');
        bfPct = bfVal;
      }
    } else {
      bfEl.className = INPUT_OK + ' pr-7';
      bfErr.classList.add('hidden');
    }

    if (!valid) return;

    // ── Unit conversions ──────────────────────────────────────────────────
    const weightKg = weightUnit === 'imperial' ? weightVal / 2.20462 : weightVal;

    let heightCm: number;
    if (heightUnit === 'imperial') {
      const ft = parseFloat((document.getElementById('db-ft') as HTMLInputElement).value) || 0;
      const ins = parseFloat((document.getElementById('db-in') as HTMLInputElement).value) || 0;
      heightCm = (ft * 12 + ins) * 2.54;
    } else {
      heightCm = parseFloat((document.getElementById('db-cm') as HTMLInputElement).value);
    }

    // ── BMR ───────────────────────────────────────────────────────────────
    let bmr: number;
    let formula: string;
    if (bfPct !== null) {
      const leanMass = weightKg * (1 - bfPct / 100);
      bmr = 370 + 21.6 * leanMass;
      formula = 'Katch-McArdle';
    } else {
      const base = 10 * weightKg + 6.25 * heightCm - 5 * age;
      bmr = sex === 'male' ? base + 5 : base - 161;
      formula = 'Mifflin-St Jeor';
    }

    // ── TDEE ─────────────────────────────────────────────────────────────
    const activityMultiplier = parseFloat((document.getElementById('db-activity') as HTMLSelectElement).value);
    const tdee = bmr * activityMultiplier;

    // ── Adaptive thermogenesis offset ─────────────────────────────────────
    let offset = 0;
    if (weeks <= 8) {
      offset = 0;
    } else if (weeks <= 16) {
      offset = 5;
    } else {
      offset = 8;
    }
    const adjustedTDEE = tdee * (1 - offset / 100);

    // ── Results ───────────────────────────────────────────────────────────
    const maintenanceTarget = Math.round(adjustedTDEE);
    const recoveryCeiling = Math.round(adjustedTDEE * 1.05);
    const deficitAmt = maintenanceTarget - Math.round(currentCals);

    renderResults({
      maintenanceTarget,
      recoveryCeiling,
      deficitAmt,
      tdee: Math.round(tdee),
      adjustedTDEE: maintenanceTarget,
      offset,
      weeks: Math.round(weeks),
      currentCals: Math.round(currentCals),
      breakType,
      formula,
    });
  });

  // ── Render Results ────────────────────────────────────────────────────────
  function renderResults(d: {
    maintenanceTarget: number; recoveryCeiling: number; deficitAmt: number;
    tdee: number; adjustedTDEE: number; offset: number; weeks: number;
    currentCals: number; breakType: string; formula: string;
  }) {
    const m = d.maintenanceTarget.toLocaleString();
    const rc = d.recoveryCeiling.toLocaleString();
    const cc = d.currentCals.toLocaleString();
    const defSign = d.deficitAmt >= 0 ? '+' : '';

    const offsetBadge = d.offset > 0
      ? `<span class="pill text-xs font-medium bg-white/[0.1] px-3 py-1 rounded-full">−${d.offset}% adaptive offset applied</span>`
      : '';

    const adaptiveNote = d.offset > 0
      ? `<p class="result-label mt-3 text-xs leading-relaxed">After ${d.weeks} weeks of continuous dieting, your predicted TDEE has been reduced by ${d.offset}% to account for metabolic adaptation.</p>`
      : '';

    const scheduleHtml = renderSchedule(d.breakType, d.maintenanceTarget, d.currentCals);

    const adaptiveWeeksNote = d.offset === 0
      ? `<p class="text-xs text-gray-500 mt-3 leading-relaxed">You've been dieting for ${d.weeks} week${d.weeks === 1 ? '' : 's'}, which is within the range where significant metabolic adaptation is unlikely.</p>`
      : d.offset === 5
      ? `<p class="text-xs text-amber-700 mt-3 leading-relaxed bg-amber-50 border border-amber-100 rounded-lg px-3 py-2"><strong>Note:</strong> After 9–16 weeks of dieting, metabolic adaptation is likely. A 5% offset has been applied to your predicted TDEE.</p>`
      : `<p class="text-xs text-amber-700 mt-3 leading-relaxed bg-amber-50 border border-amber-100 rounded-lg px-3 py-2"><strong>Note:</strong> After 16+ weeks of continuous dieting, significant metabolic adaptation is expected. An 8% offset has been applied. A full 2-week break is strongly recommended.</p>`;

    const xMarkSVG = `<svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M3.72 3.72a.75.75 0 0 1 1.06 0L8 6.94l3.22-3.22a.75.75 0 1 1 1.06 1.06L9.06 8l3.22 3.22a.75.75 0 1 1-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 0 1-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 0 1 0-1.06z" clip-rule="evenodd"/></svg>`;
    const checkSVG = `<svg class="w-3.5 h-3.5 text-violet flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207z" clip-rule="evenodd"/></svg>`;

    const html = `
      <div class="animate-fade-up space-y-4">

        <!-- Section 1: Maintenance Target -->
        <div class="rounded-2xl bg-gray-950 result-hero p-6 sm:p-8 text-white">
          <p class="result-label text-sm font-medium mb-2 tracking-wide">Diet Break Calories</p>
          <div class="flex items-baseline gap-3 flex-wrap">
            <span class="text-6xl sm:text-7xl font-extrabold tracking-tight tabular-nums leading-none">${m}</span>
            <span class="result-label text-xl font-semibold">cal / day</span>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="pill text-xs font-medium bg-white/[0.1] px-3 py-1 rounded-full">
              Base TDEE: ${d.tdee.toLocaleString()} cal · ${d.formula}
            </span>
            ${offsetBadge}
          </div>
          ${adaptiveNote}
        </div>

        <!-- Context card -->
        <div class="bg-white rounded-2xl shadow-sm p-5">
          <p class="text-sm text-gray-700 leading-relaxed">
            You've been eating <strong>${cc} cal/day</strong>. Your diet break target is approximately <strong>${m} cal/day</strong> — that's <strong>${defSign}${Math.abs(d.deficitAmt).toLocaleString()} calories</strong> ${d.deficitAmt >= 0 ? 'more' : 'less'} than your current intake.
          </p>
          <div class="mt-4 pt-4 border-t border-gray-100 flex items-start gap-3">
            <div class="flex-shrink-0 mt-0.5 w-8 h-8 rounded-lg bg-violet-subtle flex items-center justify-center">
              <svg class="w-4 h-4 text-violet" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm7.25-3.25a.75.75 0 0 1 1.5 0V8a.75.75 0 0 1-.75.75H5.25a.75.75 0 0 1 0-1.5H7.25V4.75z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900">Hormonal Recovery Ceiling</p>
              <p class="text-2xl font-extrabold text-gray-900 tabular-nums mt-1">${rc}<span class="text-base font-semibold text-gray-500 ml-1.5">cal/day</span></p>
              <p class="text-xs text-gray-500 mt-1.5 leading-relaxed">If you're feeling lethargic or training hard, you can eat up to this amount during your break without meaningful fat gain.</p>
            </div>
          </div>
          ${adaptiveWeeksNote}
        </div>

        <!-- Section 2: Break Schedule -->
        <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
          <div class="px-5 py-3.5 border-b border-gray-100">
            <p class="text-sm font-semibold text-gray-900">Your Break Schedule</p>
          </div>
          <div class="p-5">
            ${scheduleHtml}
          </div>
        </div>

        <!-- Section 3: What to Expect -->
        <div class="flex gap-3 px-5 py-4 bg-blue-50 rounded-2xl border border-blue-100">
          <svg class="w-4 h-4 text-blue-500 flex-shrink-0 mt-0.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0zm-9.25-.75a.75.75 0 0 0 0 1.5h1.5v3.5a.75.75 0 0 0 1.5 0v-4.25a.75.75 0 0 0-.75-.75H5.75zm2.25-2a1 1 0 1 1-2 0 1 1 0 0 1 2 0z" clip-rule="evenodd"/>
          </svg>
          <div>
            <p class="text-sm font-semibold text-blue-800 mb-1">What to Expect on the Scale</p>
            <p class="text-sm text-blue-700 leading-relaxed">Expect a 2–4 lb increase in scale weight during the first week of your break. This is water retention and glycogen replenishment from increased carbohydrate intake — not fat gain. Your weight will stabilize by week 2 and this water weight will drop quickly when you resume your deficit.</p>
          </div>
        </div>

        <!-- Section 4: Science Comparison -->
        <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
          <div class="px-5 py-3.5 border-b border-gray-100">
            <p class="text-sm font-semibold text-gray-900">The Science: Continuous vs. Intermittent Dieting</p>
          </div>
          <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="bg-white rounded-xl border border-gray-200 p-4">
              <p class="text-sm font-bold text-gray-700 mb-3">Standard Dieting</p>
              <ul class="space-y-2">
                ${['Continuous calorie restriction', 'Metabolism adapts downward over time', 'Higher muscle loss risk over extended cuts', 'Harder to sustain psychologically'].map(item => `<li class="flex items-start gap-2 text-xs text-gray-600">${xMarkSVG}${item}</li>`).join('')}
              </ul>
            </div>
            <div class="bg-white rounded-xl p-4" style="border-left: 4px solid var(--cl-violet);">
              <div class="flex items-center gap-2 mb-3">
                <p class="text-sm font-bold text-violet-dark">MATADOR Protocol</p>
                <span class="text-xs font-medium text-violet-dark bg-violet-subtle px-1.5 py-0.5 rounded-full">Research-backed</span>
              </div>
              <ul class="space-y-2">
                ${['Alternating restriction and maintenance', 'Periodic metabolic reset via leptin and thyroid', 'Retained significantly more lean mass', 'Better long-term adherence and outcomes', 'Byrne et al. 2018 · International Journal of Obesity'].map(item => `<li class="flex items-start gap-2 text-xs text-violet-dark">${checkSVG}${item}</li>`).join('')}
              </ul>
            </div>
          </div>
        </div>

        <!-- Section 5: CTAs -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5">
          <p class="text-sm font-semibold text-gray-900 mb-4">What's Next</p>
          <div class="space-y-4">
            <div>
              <a href="/calorie-deficit-calculator/" class="inline-flex items-center justify-center gap-2 px-5 py-3 btn-calc text-white text-sm font-semibold rounded-xl transition-colors">
                Resume your cut ${ARROW_SVG}
                <span class="sr-only">Calorie Deficit Calculator</span>
              </a>
              <p class="mt-1.5 text-xs text-gray-500">When your break is over, recalculate your deficit target.</p>
            </div>
            <div>
              <a href="/macro-calculator/" class="inline-flex items-center gap-2 text-violet hover:text-violet-dark text-sm font-semibold transition-colors">
                Set your break macros → Macro Calculator ${ARROW_SVG}
              </a>
              <p class="mt-1 text-xs text-gray-500">During a diet break, keep protein high to protect muscle while increasing carbs to signal metabolic recovery.</p>
            </div>
            <div>
              <a href="/protein-calculator/" class="inline-flex items-center gap-2 text-violet hover:text-violet-dark text-sm font-semibold transition-colors">
                Check your protein target → Protein Calculator ${ARROW_SVG}
              </a>
            </div>
          </div>
        </div>

      </div>`;

    const resultsEl = document.getElementById('db-results')!;
    resultsEl.innerHTML = html;
    resultsEl.classList.remove('hidden');
    resultsEl.classList.remove('results-updated');
    void resultsEl.offsetWidth;
    resultsEl.classList.add('results-updated');
    setTimeout(() => resultsEl.classList.remove('results-updated'), 700);
    const _heroNum = resultsEl.querySelector('[class*="text-6xl"]');
    if (_heroNum) { _heroNum.classList.add('number-pop'); }

    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', 'calculator_complete', { 'calculator_name': 'diet_break' });
    }
    setTimeout(() => {
      const top = resultsEl.getBoundingClientRect().top + window.scrollY - 88;
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    }, 80);
  }

  // ── Render Schedule ───────────────────────────────────────────────────────
  function renderSchedule(type: string, maintenanceCals: number, dietCals: number): string {
    const m = maintenanceCals.toLocaleString();
    const d = dietCals.toLocaleString();

    const breakRow = (weeks: string, label: string) => `
      <div class="flex items-center gap-3 bg-violet-subtle border border-violet-light rounded-xl px-4 py-3">
        <span class="flex-shrink-0 text-xs font-bold text-violet-dark bg-violet-subtle px-2 py-0.5 rounded-full whitespace-nowrap">BREAK</span>
        <div>
          <p class="text-sm font-semibold text-gray-900">${weeks}: ${m} cal/day</p>
          <p class="text-xs text-gray-500">${label}</p>
        </div>
      </div>`;

    const dietRow = (weeks: string, label: string) => `
      <div class="flex items-center gap-3 bg-gray-50 border border-gray-100 rounded-xl px-4 py-3">
        <span class="flex-shrink-0 text-xs font-bold text-gray-600 bg-gray-200 px-2 py-0.5 rounded-full whitespace-nowrap">DIET</span>
        <div>
          <p class="text-sm font-semibold text-gray-900">${weeks}: ${d} cal/day</p>
          <p class="text-xs text-gray-500">${label}</p>
        </div>
      </div>`;

    if (type === 'matador') {
      return `
        <p class="text-sm text-gray-600 mb-3">2 weeks at maintenance → 2 weeks at your deficit → repeat. One full cycle = 4 weeks.</p>
        <div class="space-y-2">
          ${breakRow('Weeks 1–2', 'Eat at maintenance. Restore leptin, thyroid, and training energy.')}
          ${dietRow('Weeks 3–4', 'Return to your deficit. Fat loss resumes with improved metabolic rate.')}
          ${breakRow('Weeks 5–6', 'Second break cycle. Continued hormonal recovery.')}
          ${dietRow('Weeks 7–8', 'Resume deficit. Reassess progress at the end of this cycle.')}
        </div>
        <p class="text-xs text-gray-500 pt-3 px-1">After 2 full cycles (8 weeks), reassess your progress and continue as needed.</p>`;
    }

    if (type === 'standard') {
      return `
        <p class="text-sm text-gray-600 mb-3">1 week at maintenance for every 4 weeks of dieting.</p>
        <div class="space-y-2">
          ${dietRow('Weeks 1–4', 'Maintain your calorie deficit.')}
          ${breakRow('Week 5', 'Take your planned break. Recharge mentally and physically.')}
        </div>
        <p class="text-xs text-gray-500 pt-3 px-1">↻ Repeat this 5-week cycle until you reach your goal weight.</p>`;
    }

    // maintenance phase
    return `
      <p class="text-sm text-gray-600 mb-3">Eat at maintenance indefinitely until weight stabilizes, then reassess your goals.</p>
      <div class="bg-violet-subtle border border-violet-light rounded-xl px-4 py-4">
        <div class="flex items-center gap-3 mb-2">
          <span class="text-xs font-bold text-violet-dark bg-violet-subtle px-2 py-0.5 rounded-full">MAINTENANCE</span>
          <p class="text-sm font-semibold text-gray-900">Every day: ${m} cal/day</p>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed">Eat at maintenance until your weight stabilizes for 2–3 consecutive weeks. Once stable, you can choose to resume your deficit, continue at maintenance, or begin a slow lean bulk.</p>
      </div>
      <p class="text-xs text-gray-500 pt-3 px-1">Track weekly weight averages rather than daily fluctuations to identify when weight has truly stabilized.</p>`;
  }
</script>
