---
interface Props {
  calculators?: string[];
}

const { calculators = ["tdee", "macro", "calorie-deficit"] } = Astro.props;

const CALC_DATA: Record<string, { name: string; href: string; desc: string; icon: string }> = {
  tdee: {
    name: "TDEE Calculator",
    href: "/tdee-calculator/",
    desc: "Find your total daily calorie burn",
    icon: `<path d="M8 2c-1 2-4 4.5-4 7a4 4 0 0 0 8 0C12 6.5 9 4 8 2z"/>`,
  },
  macro: {
    name: "Macro Calculator",
    href: "/macro-calculator/",
    desc: "Set protein, carb & fat targets",
    icon: `<path d="M8 8L8 2A6 6 0 0 1 11.53 12.85Z"/><path d="M8 8L11.53 12.85A6 6 0 0 1 2 8Z" opacity="0.65"/><path d="M8 8L2 8A6 6 0 0 1 8 2Z" opacity="0.4"/>`,
  },
  "calorie-deficit": {
    name: "Calorie Deficit Calculator",
    href: "/calorie-deficit-calculator/",
    desc: "Calculate calories for fat loss",
    icon: `<rect x="1.5" y="3" width="3" height="10" rx="1"/><rect x="6.5" y="5.5" width="3" height="7.5" rx="1"/><rect x="11.5" y="8" width="3" height="5" rx="1"/>`,
  },
  bmr: {
    name: "BMR Calculator",
    href: "/bmr-calculator/",
    desc: "Calculate your resting metabolic rate",
    icon: `<path d="M8 12.5c-3.5-2.5-6.5-5-6.5-8a3.5 3.5 0 0 1 6.5-2 3.5 3.5 0 0 1 6.5 2c0 3-3 5.5-6.5 8z"/>`,
  },
  protein: {
    name: "Protein Calculator",
    href: "/protein-calculator/",
    desc: "Dial in your daily protein target",
    icon: `<rect x="1" y="5.5" width="3.5" height="5" rx="1"/><rect x="11.5" y="5.5" width="3.5" height="5" rx="1"/><rect x="4" y="7.25" width="8" height="1.5" rx="0.75"/>`,
  },
  bmi: {
    name: "BMI Calculator",
    href: "/bmi-calculator/",
    desc: "Check your body mass index",
    icon: `<circle cx="8" cy="4" r="2.5"/><path d="M4 14.5v-3a4 4 0 0 1 8 0v3z"/>`,
  },
  "body-fat": {
    name: "Body Fat Calculator",
    href: "/body-fat-calculator/",
    desc: "Estimate your body fat percentage",
    icon: `<rect x="1" y="7" width="14" height="2" rx="1"/><rect x="2.5" y="5" width="1.5" height="2" rx="0.5"/><rect x="5.5" y="5.5" width="1.5" height="1.5" rx="0.5"/><rect x="8.5" y="5" width="1.5" height="2" rx="0.5"/><rect x="11.5" y="5.5" width="1.5" height="1.5" rx="0.5"/>`,
  },
  "ideal-weight": {
    name: "Ideal Weight Calculator",
    href: "/ideal-weight-calculator/",
    desc: "Find your healthy weight range",
    icon: `<circle cx="8" cy="8" r="7" opacity="0.2"/><circle cx="8" cy="8" r="4" opacity="0.5"/><circle cx="8" cy="8" r="1.5"/>`,
  },
  water: {
    name: "Water Intake Calculator",
    href: "/water-intake-calculator/",
    desc: "Personalized daily hydration target",
    icon: `<path d="M8 2C6 5 3 7.5 3 10a5 5 0 0 0 10 0C13 7.5 10 5 8 2z"/>`,
  },
};

const items = calculators.map(key => CALC_DATA[key]).filter(Boolean);
---

<div class="space-y-3">
<div class="rounded-2xl overflow-hidden border border-gray-100">
  <div class="px-4 py-3 lg:px-5" style="background-color: var(--cl-dark-nav);">
    <h3 class="text-sm font-bold text-white">Related Calculators</h3>
  </div>

  <!-- Mobile: horizontal 3-column grid (compact, no desc) -->
  <!-- Desktop: vertical list (full card with desc) -->
  <div class="bg-white grid grid-cols-3 gap-2 p-3 lg:hidden">
    {items.map(calc => (
      <a
        href={calc.href}
        class="group flex flex-col items-center gap-1.5 p-2.5 rounded-xl hover:bg-gray-50 transition-all text-center"
      >
        <div class="w-8 h-8 rounded-lg flex items-center justify-center transition-colors flex-shrink-0" style="background: var(--cl-violet);">
          <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" set:html={calc.icon} />
        </div>
        <p class="text-xs font-semibold text-gray-800 group-hover:text-violet transition-colors leading-tight">{calc.name}</p>
      </a>
    ))}
  </div>

  <div class="bg-white hidden lg:block p-3 space-y-1">
    {items.map(calc => (
      <a
        href={calc.href}
        class="group flex items-start gap-3 p-3 rounded-xl hover:bg-gray-50 transition-all"
      >
        <svg
          class="mt-0.5 flex-shrink-0 w-4 h-4 text-violet"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
          set:html={calc.icon}
        />
        <div>
          <div class="text-sm font-medium text-gray-800 group-hover:text-violet transition-colors">{calc.name}</div>
          <div class="text-xs text-gray-500 mt-0.5 leading-relaxed">{calc.desc}</div>
        </div>
      </a>
    ))}
  </div>
</div>

<!-- Daily Foundation CTA -->
<div class="rounded-2xl overflow-hidden border border-gray-100">
  <div class="px-4 py-3 lg:px-5" style="background: linear-gradient(to right, rgba(34,211,238,0.45) 0%, rgba(124,58,237,0.42) 100%), var(--cl-dark-nav);">
    <h3 class="text-sm font-bold text-white">Build Your Daily Foundation</h3>
  </div>

  <!-- Habit Tracker row -->
  <a href="/daily-habit-tracker/" class="group block p-3 bg-white hover:bg-gray-50 transition-all border-b border-gray-100">
    <div class="flex items-center gap-2.5 mb-1">
      <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(34,211,238,0.12);">
        <svg class="w-3.5 h-3.5" style="color: #0e9aae;" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <circle cx="8" cy="8" r="6" opacity="0.28"/>
          <path d="M5.5 8.5l2 1.5 3-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </div>
      <div class="text-sm font-semibold text-gray-800 group-hover:text-violet transition-colors">Habit Tracker</div>
    </div>
    <div class="pl-[42px]">
      <div class="text-xs text-gray-500 leading-relaxed">Track your daily wins. Pick habits, check them off, build a streak.</div>
      <div class="mt-1.5 text-xs font-semibold" style="color: var(--cl-violet);">Start tracking →</div>
    </div>
  </a>

  <!-- Food Log row -->
  <a href="/food-log/" class="group block p-3 bg-white hover:bg-gray-50 transition-all">
    <div class="flex items-center gap-2.5 mb-1">
      <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(249,115,22,0.12);">
        <svg class="w-3.5 h-3.5" style="color: #ea6c0a;" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 14Q5.5 10 5.5 6Q5.5 3 8 3Q10.5 3 10.5 6Q10.5 10 8 14Z"/>
          <path d="M7 3.5Q5.5 1.5 5 1Q5.5 0.5 7 2Q7.5 3 7 3.5Z" opacity="0.65"/>
          <path d="M8 3Q7.5 1.5 8 0.5Q8.5 1.5 8 3Z" opacity="0.5"/>
          <path d="M9 3.5Q10.5 1.5 11 1Q10.5 0.5 9 2Q8.5 3 9 3.5Z" opacity="0.65"/>
        </svg>
      </div>
      <div class="text-sm font-semibold text-gray-800 group-hover:text-violet transition-colors">Food Log</div>
    </div>
    <div class="pl-[42px]">
      <div class="text-xs text-gray-500 leading-relaxed">Log what you eat. No counting, just awareness that builds better habits.</div>
      <div class="mt-1.5 text-xs font-semibold" style="color: var(--cl-violet);">Start logging →</div>
    </div>
  </a>
</div>

</div>
