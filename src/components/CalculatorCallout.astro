---
interface Props {
  label: string;
  text: string; // contains {{calculator}} placeholder
  calculatorName: string;
  calculatorLink: string;
}

const { label, text, calculatorName, calculatorLink } = Astro.props;
const [before, after] = text.split("{{calculator}}");
---

<aside
  class="not-prose rounded-2xl my-8 p-5 sm:p-6"
  aria-label="Calculator tip"
  style="
    background-color: oklch(26% 0.24 292);
    background-image: linear-gradient(135deg, rgba(255,255,255,.13) 0%, rgba(255,255,255,.03) 55%, rgba(255,255,255,.07) 100%);
    border: 1px solid rgba(255,255,255,.16);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.18), inset 0 -1px 0 rgba(0,0,0,.3), 0 8px 32px rgba(0,0,0,.3), 0 0 40px rgba(134,80,252,0.18);
  "
>
  <div class="flex items-start gap-4">

    <!-- Contained icon — top-aligned, SVG centered inside -->
    <div
      class="flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-xl"
      style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.18); margin-top: 1px;"
    >
      <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 3H15"/>
        <path d="M10 3v4.5L5.5 14A2 2 0 0 0 7.11 17H16.89A2 2 0 0 0 18.5 14L14 7.5V3"/>
      </svg>
    </div>

    <!-- Text — label inline with body, no imposed spacing -->
    <div class="min-w-0">
      <p class="text-sm text-white leading-relaxed" style="margin-bottom: 0;">
        <strong class="font-bold">{label}</strong>{" "}{before}<a
          href={calculatorLink}
          class="callout-link font-semibold underline underline-offset-2 text-white transition-colors"
          style="text-decoration-color: rgba(255,255,255,0.45);"
        >{calculatorName}</a>{after ?? ""}
      </p>
      <p class="text-xs font-medium mt-2" style="color: rgba(255,255,255,0.45); margin-bottom: 0;">No account required.</p>
    </div>

  </div>
</aside>

<style>
  .callout-link:hover {
    text-decoration-color: white;
  }
</style>
