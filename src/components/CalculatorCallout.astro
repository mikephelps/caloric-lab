---
interface Props {
  label: string;
  text: string; // contains {{calculator}} placeholder
  calculatorName: string;
  calculatorLink: string;
}

const { label, text, calculatorName, calculatorLink } = Astro.props;
const [before, after] = text.split("{{calculator}}");
---

<aside class="not-prose flex rounded-xl overflow-hidden my-8" style="box-shadow: 0 4px 16px rgba(0,0,0,0.18), 0 0 22px rgba(165,243,252,0.18);" aria-label="Calculator tip">
  <!-- Left accent bar — lighter shade -->
  <div class="w-1 shrink-0" style="background-color: #3BA8C0;" aria-hidden="true"></div>

  <!-- Content -->
  <div class="flex-1 px-5 py-3 sm:px-6 flex items-start" style="background-color: #0D7490; gap: 12px;">
    <!-- Book icon -->
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M12 6.45455C12 5.53834 12.3566 4.65967 12.9913 4.01181C13.6261 3.36396 14.487 3 15.3846 3H23V18.5455H15.3846C14.487 18.5455 13.6261 18.9094 12.9913 19.5573C12.3566 20.2051 12 21.0838 12 22" stroke="#A5F3FC" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M1 18.5455H8.61538C9.51304 18.5455 10.3739 18.9094 11.0087 19.5573C11.6434 20.2051 12 21.0838 12 22V6.45455C12 5.53834 11.6434 4.65967 11.0087 4.01181C10.3739 3.36396 9.51304 3 8.61538 3H1V18.5455Z" stroke="#A5F3FC" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M16 8H20" stroke="#A5F3FC" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M16 11H20" stroke="#A5F3FC" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M16 14H20" stroke="#A5F3FC" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <!-- Text -->
    <div>
      <p class="text-md text-white leading-relaxed" style="margin-bottom: 0.75rem;">
        <strong class="font-bold">{label}</strong>{" "}
        {before}<a
          href={calculatorLink}
          class="callout-link font-semibold underline underline-offset-2 text-white transition-colors"
          style="text-decoration-color: rgba(255,255,255,0.5);"
        >{calculatorName}</a>{after ?? ""}
      </p>
      <p class="mt-0.5 text-xs font-medium" style="color: rgba(255,255,255,0.65); margin-bottom: 0;">No account required.</p>
    </div>
  </div>
</aside>

<style>
  .callout-link:hover {
    color: #a5f3fc;
  }
</style>
