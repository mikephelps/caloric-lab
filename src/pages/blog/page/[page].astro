---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";

const PAGE_SIZE = 10;

export async function getStaticPaths() {
  const { getCollection } = await import("astro:content");
  const PAGE_SIZE = 10;
  const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );
  const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const pageNum = i + 2;
    const start = (pageNum - 1) * PAGE_SIZE;
    return {
      params: { page: String(pageNum) },
      props: { posts: allPosts.slice(start, start + PAGE_SIZE), pageNum, totalPages },
    };
  });
}

const { posts, pageNum, totalPages } = Astro.props;

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
}

const prevUrl = pageNum === 2 ? "/blog/" : `/blog/page/${pageNum - 1}/`;
const nextUrl = pageNum < totalPages ? `/blog/page/${pageNum + 1}/` : null;
---

<Layout
  title={`Blog — Page ${pageNum} | CaloricLab`}
  description="Evidence-based nutrition and fitness insights to help you make smarter decisions about your health."
>
  <!-- Blog header — dark aurora band -->
  <header class="relative overflow-hidden py-10 sm:py-12" style="background-color: var(--cl-dark-nav);">
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1160 160" preserveAspectRatio="xMidYMid slice">
        <defs>
          <filter id="blog-blur1"><feGaussianBlur stdDeviation="22"/></filter>
          <filter id="blog-blur2"><feGaussianBlur stdDeviation="32"/></filter>
          <filter id="blog-blur3"><feGaussianBlur stdDeviation="18"/></filter>
        </defs>
        <ellipse cx="200" cy="120" rx="420" ry="70" fill="none" style="stroke: var(--cl-teal-dark);" stroke-width="50" opacity="0.14" filter="url(#blog-blur1)" transform="rotate(-6 200 120)"/>
        <ellipse cx="640" cy="80" rx="400" ry="55" fill="none" style="stroke: var(--cl-violet);" stroke-width="44" opacity="0.10" filter="url(#blog-blur2)" transform="rotate(3 640 80)"/>
        <ellipse cx="980" cy="50" rx="280" ry="42" fill="none" style="stroke: var(--cl-teal);" stroke-width="30" opacity="0.09" filter="url(#blog-blur3)" transform="rotate(-4 980 50)"/>
        <ellipse cx="480" cy="140" rx="320" ry="38" fill="none" style="stroke: var(--cl-teal-mid);" stroke-width="34" opacity="0.08" filter="url(#blog-blur2)" transform="rotate(5 480 140)"/>
      </svg>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-white">Blog</h1>
      <p class="mt-2 text-sm sm:text-base max-w-2xl" style="color: rgba(255,255,255,0.55);">Evidence-based nutrition and fitness insights to help you make smarter decisions about your health.</p>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">

    <div class="flex items-center justify-between mb-6">
      <a href="/blog/" class="inline-flex items-center gap-1.5 text-sm font-semibold transition-colors" style="color: var(--cl-violet-dark);" onmouseenter="this.style.color='var(--cl-violet)';" onmouseleave="this.style.color='var(--cl-violet-dark)';">
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M7.78 12.53a.75.75 0 0 1-1.06 0L2.47 8.28a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 1.06L4.56 7.5H13a.75.75 0 0 1 0 1.5H4.56l3.22 3.22a.75.75 0 0 1 0 1.06z" clip-rule="evenodd"/>
        </svg>
        All articles
      </a>
    </div>

    <div class="flex flex-wrap items-center gap-2 mb-8">
      <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider mr-1">Browse:</span>
      {["All", "Weight Loss", "Body Composition", "Nutrition Basics", "Metabolism", "Hydration"].map(cat => (
        <button
          data-filter={cat}
          class:list={[
            "filter-btn cursor-pointer text-xs font-semibold px-3.5 py-1.5 rounded-full border transition-colors",
            cat === "All"
              ? "text-white border-transparent"
              : "bg-white text-gray-600 border-gray-200 hover:border-violet/40 hover:bg-violet-subtle hover:text-violet-dark",
          ]}
          style={cat === "All" ? "background: var(--cl-violet); border-color: var(--cl-violet);" : ""}
        >
          {cat}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map(post => (
        <a
          href={`/blog/${post.id.replace(/\.md$/, '')}/`}
          data-post-card
          data-tags={JSON.stringify(post.data.tags)}
          data-category={post.data.category ?? ''}
          class="group bg-white rounded-2xl border border-gray-200 overflow-hidden hover:border-violet hover:shadow-lg hover:shadow-violet/10 hover:-translate-y-0.5 transition-all duration-200 flex flex-col"
        >
          {post.data.heroImage ? (
            <div class="aspect-video bg-gray-100 overflow-hidden">
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
          ) : (
            <div class="aspect-video bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center">
              <svg class="w-10 h-10 text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
              </svg>
            </div>
          )}
          <div class="p-5 flex flex-col flex-1">
            {post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mb-3">
                {post.data.tags.slice(0, 2).map(tag => (
                  <span class="text-xs font-medium px-2 py-0.5 rounded-full" style="color: var(--cl-violet-dark); background: var(--cl-violet-subtle);">{tag}</span>
                ))}
              </div>
            )}
            <h2 class="text-base font-bold text-gray-900 group-hover:text-violet transition-colors leading-snug">{post.data.title}</h2>
            <p class="mt-2 text-sm text-gray-500 leading-relaxed line-clamp-2 flex-1">{post.data.description}</p>
            <div class="mt-4 flex items-center justify-between">
              <span class="text-xs text-gray-500">{formatDate(post.data.pubDate)}</span>
              <span class="text-xs font-semibold" style="color: var(--cl-violet);">Read more →</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Pagination -->
    <div class="mt-12 flex items-center justify-center gap-3">
      <a
        href={prevUrl}
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border text-sm font-semibold rounded-xl transition-colors"
        style="border-color: var(--cl-violet); color: var(--cl-violet);"
        onmouseenter="this.style.background='var(--cl-violet-subtle)';"
        onmouseleave="this.style.background='';"
      >
        <svg class="w-4 h-4 rotate-180" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.22 2.97a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.44 8 8.22 4.78a.75.75 0 0 1 0-1.06z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M2.75 8a.75.75 0 0 1 .75-.75h8a.75.75 0 0 1 0 1.5h-8A.75.75 0 0 1 2.75 8z" clip-rule="evenodd"/>
        </svg>
        Newer posts
      </a>
      <span class="text-sm text-gray-500">Page {pageNum} of {totalPages}</span>
      {nextUrl && (
        <a
          href={nextUrl}
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border text-sm font-semibold rounded-xl transition-colors"
          style="border-color: var(--cl-violet); color: var(--cl-violet);"
          onmouseenter="this.style.background='var(--cl-violet-subtle)';"
          onmouseleave="this.style.background='';"
        >
          Older posts
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.22 2.97a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.44 8 8.22 4.78a.75.75 0 0 1 0-1.06z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M2.75 8a.75.75 0 0 1 .75-.75h8a.75.75 0 0 1 0 1.5h-8A.75.75 0 0 1 2.75 8z" clip-rule="evenodd"/>
          </svg>
        </a>
      )}
    </div>

  </div>
</Layout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('[data-post-card]');

  const ACTIVE_CLS   = 'text-white border-transparent';
  const INACTIVE_CLS = 'bg-white text-gray-600 border-gray-200';

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'All';

      btns.forEach(b => {
        b.className = b.className.replace(ACTIVE_CLS, INACTIVE_CLS);
        (b as HTMLElement).style.background = '';
        (b as HTMLElement).style.borderColor = '';
      });
      btn.className = btn.className.replace(INACTIVE_CLS, ACTIVE_CLS);
      (btn as HTMLElement).style.background = 'var(--cl-violet)';
      (btn as HTMLElement).style.borderColor = 'var(--cl-violet)';

      const showAll = filter === 'All';
      cards.forEach(card => {
        card.style.display = showAll || card.dataset.category === filter ? '' : 'none';
      });
    });
  });
</script>
