---
import Layout from "../../layouts/Layout.astro";

const siteUrl = "https://caloriclab.com";
const pageUrl = `${siteUrl}/about/`;

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": "About CaloricLab: Science-Backed Nutrition Calculators",
      "description": "Learn about CaloricLab, free, science-backed nutrition calculators built to help you understand your body and reach your health goals.",
      "author": { "@id": `${pageUrl}#mike` },
    },
    {
      "@type": "Person",
      "@id": `${pageUrl}#mike`,
      "name": "Mike Phelps",
      "jobTitle": "Senior UX Designer & Nutrition Coach in Training",
      "url": pageUrl,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Cary",
        "addressRegion": "NC",
      },
      "knowsAbout": [
        "User Experience Design",
        "Nutrition Science",
        "Metabolic Health",
        "Data Privacy",
      ],
      "memberOf": {
        "@type": "Organization",
        "name": "Precision Nutrition",
        "description": "PN1 Certification Candidate",
      },
    },
  ],
};
---

<Layout
  title="About CaloricLab: Science-Backed Nutrition Calculators"
  description="Learn about CaloricLab, free, science-backed nutrition calculators built to help you understand your body and reach your health goals."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
  </Fragment>

  <!-- Page header — dark aurora band -->
  <header class="relative overflow-hidden py-10 sm:py-12" style="background-color: var(--cl-dark-nav);">
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1160 160" preserveAspectRatio="xMidYMid slice">
        <defs>
          <filter id="ab1"><feGaussianBlur stdDeviation="22"/></filter>
          <filter id="ab2"><feGaussianBlur stdDeviation="32"/></filter>
          <filter id="ab3"><feGaussianBlur stdDeviation="18"/></filter>
        </defs>
        <ellipse cx="200" cy="120" rx="420" ry="70" fill="none" stroke="#0e7490" stroke-width="50" opacity="0.14" filter="url(#ab1)" transform="rotate(-6 200 120)"/>
        <ellipse cx="640" cy="80" rx="400" ry="55" fill="none" stroke="oklch(59% 0.24 292)" stroke-width="44" opacity="0.10" filter="url(#ab2)" transform="rotate(3 640 80)"/>
        <ellipse cx="980" cy="50" rx="280" ry="42" fill="none" stroke="#22d3ee" stroke-width="30" opacity="0.09" filter="url(#ab3)" transform="rotate(-4 980 50)"/>
        <ellipse cx="480" cy="140" rx="320" ry="38" fill="none" stroke="#0891b2" stroke-width="34" opacity="0.08" filter="url(#ab2)" transform="rotate(5 480 140)"/>
      </svg>
    </div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-white">About CaloricLab</h1>
      <p class="mt-2 text-sm sm:text-base max-w-2xl" style="color: rgba(255,255,255,0.55);">Free, accurate, science-backed nutrition calculators for everyone.</p>
    </div>
  </header>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-10">

    <!-- Lead section -->
    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-3">Mission</h2>
      <p class="text-xl text-gray-700 leading-relaxed font-medium">
        I'm Mike, a Senior UX Designer and the founder of CaloricLab. I built this platform because I believe nutrition science should be accessible, not gatekept. As a designer currently working toward my Precision Nutrition (PN1) certification, I wanted to bridge the gap between complex peer-reviewed formulas and the everyday tools we use to hit our goals.
      </p>
      <br>
      <p class="text-xl text-gray-700 leading-relaxed font-medium">
        Most fitness apps want your email address, your location, and a monthly subscription before they'll even show you your BMR. I'm building a faster, privacy-first alternative. No accounts, no paywalls, just science-backed tools that get out of your way so you can get to work.
      </p>
    </div>

    <hr class="border-gray-100"/>

    <!-- Our approach -->
    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-3">Our Approach</h2>
      <p class="text-gray-600 leading-relaxed">
        There's a lot of noise in the nutrition world. Fad diets, conflicting advice, and overcomplicated
        systems leave most people more confused than when they started. CaloricLab cuts through that.
      </p>
      <blockquote class="mt-5 pl-4 border-l-4 py-3 pr-4 rounded-r-xl" style="border-color: var(--cl-violet); background-color: var(--cl-violet-subtle);">
        <p class="text-gray-700 font-medium leading-relaxed italic">
          Give people the right numbers, explain the science clearly, and get out of the way.
        </p>
      </blockquote>
      <p class="mt-4 text-gray-600 leading-relaxed">
        We're not here to sell you a program or a supplement. We're here to give you the tools
        to make informed decisions.
      </p>
    </div>

  </div>

  <!-- Science We Use — dark, full-width -->
  <section class="py-16 sm:py-20" style="background-color: var(--cl-dark-card);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-white">The Science We Use</h2>
        <p class="mt-3 max-w-2xl mx-auto text-sm leading-relaxed" style="color: rgba(255,255,255,0.55);">Every calculator on CaloricLab is built on peer-reviewed research. These are the validated formulas and guidelines behind the numbers.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          {
            title: "Mifflin-St Jeor",
            desc: "The gold-standard BMR formula for the general population. Used by CaloricLab to provide the most accurate daily calorie baseline.",
            href: "https://pubmed.ncbi.nlm.nih.gov/2305711/",
          },
          {
            title: "Katch-McArdle",
            desc: "Optimized for those who know their body fat percentage. This formula calculates BMR based on lean muscle mass for higher precision.",
            href: "https://en.wikipedia.org/wiki/Basal_metabolic_rate#Katch%E2%80%93McArdle_formula",
          },
          {
            title: "ISSN Protein Guidelines",
            desc: "Science-backed protein intake targets for muscle preservation and fat loss, based on the latest sports nutrition research.",
            href: "https://www.tandfonline.com/doi/full/10.1186/s12970-017-0177-8",
          },
          {
            title: "ACSM Activity Multipliers",
            desc: "The industry-standard activity levels used to calculate your Total Daily Energy Expenditure (TDEE) from your resting metabolism.",
            href: "https://acsm.org/education-resources/trending-topics-resources/physical-activity-guidelines/",
          },
          {
            title: "National Academies: Water DRI",
            desc: "Evidence-based daily water intake targets. Calculates hydration needs based on biological sex, weight, and metabolic water loss.",
            href: "https://nap.nationalacademies.org/catalog/10925/dietary-reference-intakes-for-water-potassium-sodium-chloride-and-sulfate",
          },
          {
            title: "WHO BMI Classifications",
            desc: "The official BMI categories used globally to assess weight-to-height ratios and health risk classifications.",
            href: "https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight",
          },
          {
            title: "US Navy Body Fat Method",
            desc: "A validated body fat percentage formula using physical measurements. A reliable alternative to expensive DEXA scans.",
            href: "https://pubmed.ncbi.nlm.nih.gov/6497226/",
          },
          {
            title: "Devine & IBW Formulas",
            desc: "The standard medical formulas for calculating Ideal Body Weight. Used in clinical settings to determine healthy weight ranges.",
            href: "https://pubmed.ncbi.nlm.nih.gov/10981254/",
          },
          {
            title: "MATADOR Protocol (Byrne et al., 2018)",
            desc: "The research basis for the Diet Break Calculator. Intermittent energy restriction produced greater fat loss and lean mass retention than continuous dieting.",
            href: "https://doi.org/10.1038/ijo.2017.206",
          },
        ].map(item => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex gap-3 p-5 rounded-xl transition-all duration-200 hover:-translate-y-0.5"
            style="background: var(--glass-bg); border: var(--glass-border); box-shadow: var(--glass-shadow);"
          >
            <div class="flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center mt-0.5" style="background: var(--cl-violet);">
              <svg class="w-4 h-4 text-white" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-white group-hover:text-violet-light transition-colors flex items-center gap-1.5">
                {item.title}
                <svg class="w-3 h-3 flex-shrink-0 opacity-40 group-hover:opacity-100 transition-opacity" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd"/>
                </svg>
              </p>
              <p class="text-xs mt-0.5 leading-relaxed" style="color: rgba(255,255,255,0.5);">{item.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-10">

    <!-- Free & Privacy side by side -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="p-5 rounded-2xl shadow-sm bg-white">
        <div class="flex items-center gap-2 mb-3">
          <svg class="w-5 h-5" style="color: var(--cl-violet);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 12v10H4V12"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
          </svg>
          <h3 class="font-bold text-gray-900">Completely Free</h3>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed">
          No account required, no email signups, no paywalls. All calculators are and will always be
          100% free. We're supported by display advertising, not by selling your data.
        </p>
      </div>

      <div class="p-5 rounded-2xl shadow-sm bg-white">
        <div class="flex items-center gap-2 mb-3">
          <svg class="w-5 h-5" style="color: var(--cl-violet);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <h3 class="font-bold text-gray-900">Privacy First</h3>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed">
          Every calculation happens in your browser. Your age, weight, height, and other
          health data never leaves your device. No 3rd party trackers or data selling. See our <a href="/privacy/" style="color: var(--cl-violet-dark); font-weight: 500;" class="hover:underline">Privacy Policy</a>.
        </p>
      </div>
    </div>

    <hr class="border-gray-100"/>

    <!-- Contact -->
    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-3">Contact</h2>
      <p class="text-gray-600 leading-relaxed">
        Have a question, found an error, or want to suggest a new calculator? We'd love to hear from you.
        Reach us at{" "}
        <a href="mailto:hello.caloriclab@proton.me" style="color: var(--cl-violet-dark); font-weight: 500;" class="hover:underline">hello.caloriclab@proton.me</a>.
      </p>
    </div>

  </div>
</Layout>
